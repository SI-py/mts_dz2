.PHONY: smoke full build test docs lint stop
smoke:
	python3 scripts/run.py smoke --reset
full:
	python3 scripts/run.py full --reset
build:
	python3 scripts/run.py build
test:
	python3 scripts/run.py test
docs:
	python3 scripts/run.py docs
lint:
	python3 scripts/run.py lint
stop:
	python3 scripts/run.py stop
